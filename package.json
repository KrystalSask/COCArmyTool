{
  "name": "coc-army-tool",
  "private": true,
  "version": "0.3.0",
  "description": "部落冲突国服 18 本配兵链接、截图识别与本地方案管理工具",
  "author": "Yan Yushuai",
  "license": "PolyForm-Noncommercial-1.0.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/KrystalSask/COCArmyTool.git"
  },
  "engines": {
    "node": ">=22"
  },
  "type": "module",
  "scripts": {
    "start": "node scripts/start.mjs desktop",
    "launcher": "node scripts/start.mjs",
    "check": "node scripts/start.mjs check",
    "dev": "vite",
    "build": "tsc -b && vite build",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "preview": "vite preview",
    "desktop:dev": "tauri dev",
    "desktop:build": "tauri build --bundles nsis",
    "desktop:release": "tauri build --no-bundle",
    "release:portable": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/package-portable.ps1",
    "generate:data": "node scripts/generate-game-data.mjs",
    "catalog:audit": "node scripts/audit-game-catalog.mjs",
    "samples:import": "node scripts/import-flat-recognition-dataset.mjs",
    "samples:audit": "node scripts/audit-recognition-samples.mjs",
    "samples:preprocess": "python scripts/preprocess-recognition-samples.py",
    "samples:extract-templates": "python scripts/extract-recognition-templates.py",
    "samples:merge-templates": "node scripts/merge-recognition-templates.mjs",
    "samples:plan": "node scripts/generate-recognition-collection-plan.mjs",
    "samples:variants": "python scripts/generate-recognition-variants.py",
    "dataset:army-cards": "python scripts/generate-army-card-classification-dataset.py",
    "dataset:equipment": "python scripts/generate-equipment-classification-dataset.py",
    "train:equipment": "python scripts/train-equipment-classifier.py",
    "evaluate:equipment": "python scripts/evaluate-equipment-classifier.py",
    "export:equipment": "python scripts/export-equipment-classifier.py",
    "dataset:army-real-val": "python scripts/prepare-army-card-real-validation.py",
    "dataset:army-apply-val": "python scripts/apply-army-card-validation-review.py",
    "train:army-cards": "python scripts/train-army-card-classifier.py",
    "evaluate:army-cards": "python scripts/evaluate-army-card-classifier.py",
    "models:prepare": "artifacts/.ocr-baseline-venv/Scripts/python.exe scripts/prepare-recognition-model-assets.py"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.11.1",
    "dexie": "^4.0.11",
    "onnxruntime-web": "^1.29.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@tauri-apps/cli": "^2.11.4",
    "@testing-library/react": "^16.3.0",
    "@types/node": "^26.2.0",
    "@types/react": "^19.1.10",
    "@types/react-dom": "^19.1.7",
    "@vitejs/plugin-basic-ssl": "^2.3.0",
    "@vitejs/plugin-react": "^5.0.2",
    "fake-indexeddb": "^6.2.2",
    "jsdom": "^26.1.0",
    "typescript": "~5.8.3",
    "vite": "^7.1.5",
    "vite-plugin-pwa": "^1.0.3",
    "vitest": "^3.2.4"
  }
}
