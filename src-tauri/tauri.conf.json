{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "COCArmyTool",
  "version": "0.1.0",
  "identifier": "com.cocarmytool.desktop",
  "build": {
    "beforeDevCommand": "npm run dev -- --port 1420",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [{
      "label": "main",
      "title": "COCArmyTool - COC 配兵助手",
      "width": 1440,
      "height": 900,
      "minWidth": 1100,
      "minHeight": 700,
      "resizable": true,
      "fullscreen": false
    }],
    "security": { "csp": null }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "publisher": "Yan Yushuai",
    "shortDescription": "国服 18 本配兵编辑与截图识别助手",
    "longDescription": "支持链接导入、截图识别、手动编辑和本地方案库的 COCArmyTool。",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.ico"],
    "windows": {
      "webviewInstallMode": { "type": "downloadBootstrapper", "silent": true },
      "nsis": { "displayLanguageSelector": false, "installerIcon": "icons/icon.ico", "languages": ["SimpChinese"], "installMode": "currentUser" }
    }
  }
}
